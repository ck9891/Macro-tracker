generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id
  email        String   @unique @db.Citext
  passwordHash String?  @map("password_hash")
  totpSecret   String?  @map("totp_secret")
  totpEnabled  Boolean  @default(false) @map("totp_enabled")
  isAdmin      Boolean  @default(false) @map("is_admin")
  createdAt    DateTime @default(now()) @map("created_at")

  sessions          Session[]
  magicLoginTokens  MagicLoginToken[]
  recipes           Recipe[]
  plannedMeals      PlannedMeal[]
  weightEntries     WeightEntry[]
  dailyProgress     DailyProgress[]

  @@map("users")
}

model Session {
  id        String   @id
  userId    String   @map("user_id")
  tokenHash String   @map("token_hash")
  expiresAt DateTime @map("expires_at")
  method    String
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_sessions_user")
  @@map("sessions")
}

model MagicLoginToken {
  id        String    @id
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("magic_login_tokens")
}

model Recipe {
  id               String   @id
  userId           String   @map("user_id")
  name             String
  durationMinutes  Int      @map("duration_minutes")
  servings         Int
  calories         Float
  proteinG         Float    @map("protein_g")
  carbsG           Float    @map("carbs_g")
  fatG             Float    @map("fat_g")
  ingredientsJson  String   @map("ingredients_json")
  stepsJson        String   @map("steps_json")
  createdAt        DateTime @default(now()) @map("created_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  plannedMeals PlannedMeal[]

  @@map("recipes")
}

model PlannedMeal {
  id                  String   @id
  userId              String   @map("user_id")
  recipeId            String   @map("recipe_id")
  servingsMultiplier  Float    @default(1) @map("servings_multiplier")
  createdAt           DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@map("planned_meals")
}

model WeightEntry {
  id         String   @id
  userId     String   @map("user_id")
  measuredAt DateTime @map("measured_at")
  weight     Float
  unit       String
  note       String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("weight_entries")
}

model DailyProgress {
  userId    String   @map("user_id")
  day       String
  calories  Float
  proteinG  Float    @map("protein_g")
  carbsG    Float    @map("carbs_g")
  fatG      Float    @map("fat_g")
  weightKg  Float?   @map("weight_kg")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day])
  @@map("daily_progress")
}
